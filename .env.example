# You normally do NOT need this file: run  python3 run.py  and the setup wizard asks for everything
# and writes .env for you. This is only a reference of every available setting.

# ===== Telegram (required) =====
API_ID=
API_HASH=
SESSION_NAME=mau_saver_session
CONTROL_BOT_TOKEN=          # optional admin panel bot (from @BotFather)

# ===== Routing =====
TARGET_CHANNEL=             # full id like -1001234567890 (the wizard lets you pick from a list)
COMMENT_CHAT=               # discussion group (auto-detected by the wizard)
ADMIN_IDS=                  # control-bot admins; defaults to your own account

# ===== AI caption translation (optional, any OpenAI-compatible API) =====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=auto
TRANSLATE_ENABLED=true
TRANSLATE_PROVIDER=auto      # auto | ollama | openrouter | openai | g4f   (auto = every configured provider in turn)
# Switch live from Telegram:  .ai ollama | .ai openai | .ai g4f | .ai off | .ai auto
TRANSLATE_FALLBACK_G4F=false # also try GPT4Free when the chosen provider fails / hit its limit
G4F_MODEL=                   # empty = g4f chooses

# ===== Ollama Cloud (free key: https://ollama.com/settings/keys) =====
OLLAMA_API_KEY=
OLLAMA_MODEL=auto            # auto = best model from the live catalogue; or pin e.g. glm-5.2
OLLAMA_PREFER_UNCENSORED=true

# ===== OpenRouter - FREE models only (key: https://openrouter.ai/keys) =====
OPENROUTER_API_KEY=
OPENROUTER_MODEL=auto        # auto = best free (:free) model; a pinned model must end in :free
# OLLAMA_BASE_URL=https://ollama.com   # for a local Ollama: http://localhost:11434 (no key needed)
TRANSLATE_CONCURRENCY=1

# ===== Caption =====
INCLUDE_ORIGINAL_CAPTION=true
INCLUDE_SOURCE_LINK=true
INCLUDE_COMMENT_COUNT=true

# ===== Behaviour =====
DELETE_TRIGGER_MESSAGE=true
NOTIFY_SAVED_MESSAGES=true
AUTO_DEFAULT=false

# ===== Performance =====
MAX_CONCURRENCY=4
UPLOAD_CONCURRENCY=3
COMMENT_CONCURRENCY=2
MAX_COMMENTS=20
COMMENT_DELAY=1.0
MAX_VIDEO_HEIGHT=1080
MAX_FILE_MB=0
YTDLP_FETCH_COMMENTS=false
JOB_TIMEOUT=1800
RESUME_BATCHES=true       # unfinished batches continue where they stopped after a restart
X_COOLDOWN_SECONDS=900    # skip an X account for this long after it hit a rate limit

# ===== Chat -> chat copier (.fwdsrc / .fwddst) =====
FWD_ENABLED=true
FWD_DELAY=0.7             # seconds between two copied messages (flood protection)
FWD_ID_PREFIX=ZF          # serial number under every copy: ZF-000123 (counts up, never repeats)
FWD_STRIP_LINKS=true      # remove links (http, www, t.me, hidden links) from copied text; ban list is applied too

# ===== Storage / logging =====
# DATA_DIR=./data
LOG_LEVEL=INFO


# ===== Hosting (Render / Railway ...) + Webhook =====
# SESSION_STRING=            # python3 -m scripts.export_session  (Telegram login as text, keep SECRET)
# --- More Telegram accounts: /login /accounts /logout /resume <key> in the control bot ---
# MAX_ACCOUNTS=5              # accounts running at once (the SESSION_STRING one counts)
# EXTRA_ACCOUNT_WORKERS=2     # workers per extra account
# STATE_KEY=                 # optional secret encrypting the extra accounts' sessions stored in Saved Messages
# EXTRA_SESSIONS=             # session keys (comma/space separated) started with the bot - for hosts without a disk (Render free)
# COOKIES_B64=               # base64 of cookies.txt (Instagram/YouTube...)
# X_ACCOUNTS=user:auth_token:ct0,user2:auth_token:ct0
WEBHOOK_SECRET=              # set a long random value to enable POST /webhook (see README "Webhook")
# WEBHOOK_PORT=8080          # port when running outside Render (Render sets PORT itself)
# WEBHOOK_MAX_QUEUE=200
# WEBHOOK_RATE_PER_MIN=60
# WEBHOOK_CORS_ORIGINS=https://mysite.com   # only if a browser calls the webhook directly
# KEEPALIVE_ENABLED=true      # free Render: ping our own public URL every KEEPALIVE_INTERVAL seconds (URL = RENDER_EXTERNAL_URL)
# KEEPALIVE_INTERVAL=600

# --- Watermark (also changeable live: .wm command in Telegram, or /admin) ---
WM_TEXT=
WM_ENABLED=false      # media sent to the bot / Saved Messages
WM_ON_URL=false       # media downloaded from links
WM_ON_FWD=false       # media copied by .fwd
WM_FONT=DejaVuSans-Bold   # for Bangla text use e.g. NotoSansBengali / Lohit-Bengali
WM_SIZE=5
WM_TEXT_COLOR=#FFFFFF
WM_BG_COLOR=#000000   # none = no box
WM_BG_OPACITY=50
WM_OPACITY=90
WM_POSITION=br        # tl tc tr ml mc mr bl bc br
WM_MARGIN=2
WM_ANGLE=0           # rotate the watermark (-180..180)
FWD_BAN=              # comma separated words / urls removed from forwarded captions
